								{
									"activity": "Copy_data",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "Ls_SQL_DataBase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update @{pipeline().parameters.Pl_Schema}.watermarks SET water_mark =SYSDATETIME() WHERE table_name = '@{pipeline().parameters.Pl_table_name}'",
											"type": "Expression"
										}
