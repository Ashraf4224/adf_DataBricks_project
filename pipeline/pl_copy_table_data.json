							"value": "@pipeline().globalParameters.email",
							"type": "Expression"
						},
						"table_name": {
							"value": "@pipeline().parameters.Pl_table_name",
							"type": "Expression"
						},
						"status": "Sucess"
					}
				}
			},
			{
				"name": "Execute Pipeline_on_fail",
				"type": "ExecutePipeline",
