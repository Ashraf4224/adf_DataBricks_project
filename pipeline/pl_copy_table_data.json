										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_read_Table_Data",
									"type": "DatasetReference",
									"parameters": {
										"SinP_schema": {
											"value": "@pipeline().parameters.Pl_Schema",
											"type": "Expression"
										},
										"SinP_Table_name": {
											"value": "@pipeline().parameters.Pl_table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_CSV_Files_Adls",
									"type": "DatasetReference",
									"parameters": {
										"ds_table_name": {
											"value": "@pipeline().parameters.Pl_table_name",
											"type": "Expression"
										}
									}
								}
							]
						},
