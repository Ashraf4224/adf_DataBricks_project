				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from @{pipeline().parameters.Pl_Schema}.@{pipeline().parameters.Pl_table_name} where watermark > '@{activity('read_max_water_mark_value').output.firstRow.water_mark}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_read_Table_Data",
