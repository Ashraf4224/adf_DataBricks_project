{
	"name": "Pl_Email_Send",
	"properties": {
		"activities": [
			{
				"name": "send_email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "logical_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-15.southindia.logic.azure.com:443/workflows/ad6a9592af414d18894c4b77d52b100c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=xLY9SuTVUebqFpzWyvlTGJNIDCfIafRprNHNGzoVquk",
					"body": {
						"value": "@variables('logical_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "logical_email_body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logical_body",
					"value": {
						"value": "{\n\"email\":\"@{pipeline().parameters.email_rec}\",\n\"subject\":\"@{variables('subject')}\",\n\"body\":\"The table @{pipeline().parameters.table_name} has been injected @{pipeline().parameters.status}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_rec": {
				"type": "string"
			},
			"table_name": {
				"type": "string"
			},
			"status": {
				"type": "string"
			}
		},
		"variables": {
			"logical_body": {
				"type": "String"
			},
			"subject": {
				"type": "String"
			},
			"body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-31T14:40:10Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}