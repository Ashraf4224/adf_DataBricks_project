				}
			},
			{
				"name": "logical_email_body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "preparing_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logical_body",
					"value": {
						"value": "{\n    \"email\": \"@{pipeline().parameters.email_rec}\",\n    \"subject\": \"@{variables('subject')}\",\n    \"body\": \"@{variables('prepare_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "Injection Tables",
						"type": "Expression"
					}
				}
			},
			{
				"name": "preparing_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "prepare_body",
					"value": {
						"value": "Data ingestion has been initiated for all tables. Their respective statuses are listed below: ', @{replace(string(pipeline().parameters.list_of_tables), '\"', '')} run_id is @{pipeline().parameters.Pl_run_id}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_rec": {
				"type": "string"
			},
			"list_of_tables": {
				"type": "array"
			},
			"Pl_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"logical_body": {
				"type": "String"
			},
			"subject": {
				"type": "String"
			},
			"body": {
				"type": "String"
			},
			"prepare_body": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Incremental_load"
		},
		"annotations": [],
		"lastPublishTime": "2026-11-01T04:52:03Z"
	},
