{
	"name": "Pl_Email_Send_Multiple_Email",
	"properties": {
		"activities": [
			{
				"name": "send_email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "logical_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-20.southindia.logic.azure.com:443/workflows/056f254062d641adb9bde7dec47716c0/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=YBhgtb3QjpzoDPlXnqBQHVUnIJ1BbjFLWyltRc3uCoU",
					"body": {
						"value": "@variables('logical_body')",
						"type": "Expression"
