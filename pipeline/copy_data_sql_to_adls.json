{
	"name": "copy_data_sql_to_adls",
	"properties": {
		"activities": [
			{
				"name": "checking count is greaterthan zero",
				"type": "IfCondition",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(int(pipeline().parameters.Pl_count), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Copy_data_from_sql_to_ADLS",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select * from @{pipeline().parameters.Pl_schema_name}.@{pipeline().parameters.Pl_table_name} where watermark > '@{pipeline().parameters.Pl_water_mark}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_read_Table_Data",
									"type": "DatasetReference",
									"parameters": {
										"SinP_schema": {
											"value": "@pipeline().parameters.Pl_schema_name",
											"type": "Expression"
										},
										"SinP_Table_name": {
											"value": "@pipeline().parameters.Pl_table_name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "Ds_Adls_Parqu",
									"type": "DatasetReference",
									"parameters": {
										"DS_File_name": {
											"value": "@pipeline().parameters.Pl_table_name",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Update Water_Marks_table",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Copy_data_from_sql_to_ADLS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "Ls_SQL_DataBase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update @{pipeline().parameters.Pl_schema_name}.watermarks set water_mark = SYSUTCDATETIME() where table_name = '@{pipeline().parameters.Pl_table_name}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Pl_schema_name": {
				"type": "string"
			},
			"Pl_table_name": {
				"type": "string"
			},
			"Pl_count": {
				"type": "string"
			},
			"Pl_water_mark": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Incremental_load"
		},
		"annotations": [],
		"lastPublishTime": "2026-11-02T08:27:46Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}