{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ashraf"
		},
		"LS_AzureDatabricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_AzureDatabricks'"
		},
		"Ls_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Ls_ADLS'"
		},
		"Ls_ASDLGen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Ls_ASDLGen2'"
		},
		"Ls_SQL_DataBase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Ls_SQL_DataBase'"
		},
		"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1103-082555-tj2vuv8b"
		},
		"Ls_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demo1project.dfs.core.windows.net/"
		},
		"Ls_ASDLGen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://project513.dfs.core.windows.net/"
		},
		"Ls_SQL_DataBase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project513.database.windows.net"
		},
		"Ls_SQL_DataBase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "project513"
		},
		"Ls_SQL_DataBase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "project2026"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ashraf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureDatabricks_accessToken": {
						"value": "[parameters('LS_AzureDatabricks_accessToken')]"
					},
					"Ls_ADLS_accountKey": {
						"value": "[parameters('Ls_ADLS_accountKey')]"
					},
					"Ls_ASDLGen2_accountKey": {
						"value": "[parameters('Ls_ASDLGen2_accountKey')]"
					},
					"Ls_SQL_DataBase_password": {
						"value": "[parameters('Ls_SQL_DataBase_password')]"
					},
					"LS_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"Ls_ADLS_properties_typeProperties_url": {
						"value": "[parameters('Ls_ADLS_properties_typeProperties_url')]"
					},
					"Ls_ASDLGen2_properties_typeProperties_url": {
						"value": "[parameters('Ls_ASDLGen2_properties_typeProperties_url')]"
					},
					"Ls_SQL_DataBase_properties_typeProperties_server": {
						"value": "[parameters('Ls_SQL_DataBase_properties_typeProperties_server')]"
					},
					"Ls_SQL_DataBase_properties_typeProperties_database": {
						"value": "[parameters('Ls_SQL_DataBase_properties_typeProperties_database')]"
					},
					"Ls_SQL_DataBase_properties_typeProperties_userName": {
						"value": "[parameters('Ls_SQL_DataBase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}